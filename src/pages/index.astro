<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem – GitHub Contribution Battle Arena</title>
		<style>
			body {
				font-family: sans-serif;
				max-width: 600px;
				margin: 2rem auto;
				padding: 0 1rem;
				text-align: center;
			}

			h1 {
				font-size: 2rem;
				margin-bottom: 0.25rem;
			}

			.subtitle {
				color: #555;
				margin-bottom: 2rem;
			}

			.battle-form {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.players {
				display: flex;
				gap: 1rem;
				justify-content: center;
			}

			.player label {
				display: block;
				font-weight: bold;
				margin-bottom: 0.25rem;
			}

			.player input {
				padding: 0.4rem 0.6rem;
				font-size: 1rem;
				border: 1px solid #ccc;
				border-radius: 4px;
				width: 180px;
			}

			.battle-btn {
				padding: 0.6rem 2rem;
				font-size: 1rem;
				cursor: pointer;
				background: #238636;
				color: #fff;
				border: none;
				border-radius: 4px;
				align-self: center;
			}

			.battle-btn:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			#results {
				border: 1px solid #ddd;
				border-radius: 4px;
				padding: 1rem;
				min-height: 80px;
				text-align: left;
			}

			#results p {
				margin: 0;
				color: #555;
			}

			.error {
				color: #cf222e;
			}
		</style>
	</head>
	<body>
		<h1>⚔️ Mona Mayhem</h1>
		<p class="subtitle">GitHub Contribution Battle Arena</p>

		<form class="battle-form" id="battle-form">
			<div class="players">
				<div class="player">
					<label for="player1">Player 1</label>
					<input id="player1" type="text" placeholder="GitHub username" autocomplete="off" />
				</div>
				<div class="player">
					<label for="player2">Player 2</label>
					<input id="player2" type="text" placeholder="GitHub username" autocomplete="off" />
				</div>
			</div>
			<button class="battle-btn" type="submit">⚔️ Battle!</button>
		</form>

		<div id="results">
			<p>Enter two GitHub usernames and press Battle to see who wins!</p>
		</div>

		<script>
			const form = document.getElementById('battle-form') as HTMLFormElement;
			const resultsDiv = document.getElementById('results') as HTMLDivElement;
			const btn = form.querySelector('button') as HTMLButtonElement;

			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				const p1 = (document.getElementById('player1') as HTMLInputElement).value.trim();
				const p2 = (document.getElementById('player2') as HTMLInputElement).value.trim();

				if (!p1 || !p2) {
					resultsDiv.innerHTML = '<p class="error">Please enter both usernames.</p>';
					return;
				}

				btn.disabled = true;
				resultsDiv.innerHTML = '<p>⏳ Fetching contribution data…</p>';

				try {
					const [res1, res2] = await Promise.all([
						fetch(`/api/contributions/${encodeURIComponent(p1)}`),
						fetch(`/api/contributions/${encodeURIComponent(p2)}`),
					]);

					if (!res1.ok || !res2.ok) {
						const who = !res1.ok ? p1 : p2;
						resultsDiv.innerHTML = `<p class="error">⚠️ Could not fetch data for <strong>${who}</strong>. Check the username and try again.</p>`;
						return;
					}

					const data1 = await res1.json();
					const data2 = await res2.json();

					// Determine winner based on total contributions when data is available
					if (data1.error || data2.error) {
						resultsDiv.innerHTML = `<p class="error">⚠️ Could not fetch data: ${data1.error ?? data2.error}</p>`;
					} else {
						const score1: number = data1.totalContributions ?? 0;
						const score2: number = data2.totalContributions ?? 0;

						let outcome: string;
						if (score1 > score2) {
							outcome = `🏆 <strong>${p1}</strong> wins with ${score1} contributions vs ${score2}!`;
						} else if (score2 > score1) {
							outcome = `🏆 <strong>${p2}</strong> wins with ${score2} contributions vs ${score1}!`;
						} else {
							outcome = `🤝 It's a tie! Both players have ${score1} contributions.`;
						}

						resultsDiv.innerHTML = `
							<p><strong>${p1}:</strong> ${score1} contributions</p>
							<p><strong>${p2}:</strong> ${score2} contributions</p>
							<p>${outcome}</p>
						`;
					}
				} catch (err) {
					console.error('Battle fetch error:', err);
					resultsDiv.innerHTML = '<p class="error">⚠️ Something went wrong. Please try again.</p>';
				} finally {
					btn.disabled = false;
				}
			});
		</script>
	</body>
</html>
